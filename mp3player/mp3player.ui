          <property name="styleSheet">
           <string notr="true">/* QListWidget 전체 배경 및 기본 글자 색상 */
QListWidget {
    background-color: #121212; /* 완전 블랙 또는 어두운 회색 */
    border: 1px solid #333333;
    padding: 5px;
}

/* 개별 아이템의 기본 글자 색상 및 여백 */
QListWidget::item {
    color: #FFFFFF; /* 글자색 화이트 */
    padding: 8px;
    background-color: transparent;
}

/* 마우스를 올렸을 때 (Hover) */
QListWidget::item:hover {
    background-color: #2C2C2C; /* 약간 밝은 회색 */
    color: #FFFFFF;
}

/* 선택(클릭)되었을 때 (Selected) */
QListWidget::item:selected {
    background-color: #0078D4; /* 포인트 블루 칼라 (취향에 맞게 수정 가능) */
    color: #FFFFFF;
}

/* 선택된 상태에서 마우스를 올려도 색상 유지 */
QListWidget::item:selected:hover {
    background-color: #006CBE;
}
</string>
